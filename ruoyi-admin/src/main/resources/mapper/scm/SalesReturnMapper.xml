<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.scm.mapper.SalesReturnMapper">

    <resultMap type="com.ruoyi.scm.domain.SalesReturn" id="SalesReturnResult">
        <result property="returnId"        column="return_id"        />
        <result property="returnNo"        column="return_no"        />
        <result property="deliveryNo"      column="delivery_no"      />
        <result property="contractNo"      column="contract_no"      />
        <result property="customerName"    column="customer_name"    />
        <result property="returnDate"      column="return_date"      />
        <result property="refundAmount"    column="refund_amount"    />
        <result property="inboundStatus"   column="inbound_status"   />
        <result property="returnReason"    column="return_reason"    />
        <result property="deliveryMethod"  column="delivery_method"  />
        <result property="deliveryDate"    column="delivery_date"    />
        <result property="deliveryAddress" column="delivery_address" />
        <result property="contactPerson"   column="contact_person"   />
        <result property="contactPhone"    column="contact_phone"    />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
        <result property="remark"          column="remark"           />
    </resultMap>

    <resultMap type="com.ruoyi.scm.domain.SalesReturn" id="SalesReturnDetailResult" extends="SalesReturnResult">
        <collection property="detailList" ofType="com.ruoyi.scm.domain.SalesReturnDetail">
            <result property="detailId"         column="detail_id"          />
            <result property="returnId"         column="d_return_id"        />
            <result property="seqNo"            column="seq_no"             />
            <result property="materialName"     column="material_name"      />
            <result property="productModel"     column="d_product_model"    />
            <result property="productSpec"      column="d_product_spec"     />
            <result property="unit"             column="d_unit"             />
            <result property="price"            column="d_price"            />
            <result property="orderQuantity"    column="order_quantity"     />
            <result property="deliveryQuantity" column="delivery_quantity"  />
            <result property="returnQuantity"   column="return_quantity"    />
            <result property="remark"           column="d_remark"           />
        </collection>
    </resultMap>

    <sql id="selectSalesReturnVo">
        select return_id, return_no, delivery_no, contract_no, customer_name,
               return_date, refund_amount, inbound_status, return_reason,
               delivery_method, delivery_date, delivery_address, contact_person, contact_phone,
               create_by, create_time, update_by, update_time, remark
        from scm_sales_return
    </sql>

    <select id="selectSalesReturnById" parameterType="Long" resultMap="SalesReturnDetailResult">
        select a.return_id, a.return_no, a.delivery_no, a.contract_no, a.customer_name,
               a.return_date, a.refund_amount, a.inbound_status, a.return_reason,
               a.delivery_method, a.delivery_date, a.delivery_address, a.contact_person, a.contact_phone,
               a.create_by, a.create_time, a.update_by, a.update_time, a.remark,
               d.detail_id, d.return_id as d_return_id, d.seq_no,
               d.material_name, d.product_model as d_product_model,
               d.product_spec as d_product_spec, d.unit as d_unit,
               d.price as d_price, d.order_quantity, d.delivery_quantity, d.return_quantity,
               d.remark as d_remark
        from scm_sales_return a
        left join scm_sales_return_detail d on a.return_id = d.return_id
        where a.return_id = #{returnId}
        order by d.seq_no
    </select>

    <select id="selectSalesReturnList" parameterType="com.ruoyi.scm.domain.SalesReturn" resultMap="SalesReturnResult">
        <include refid="selectSalesReturnVo"/>
        <where>
            <if test="returnNo != null and returnNo != ''">
                AND return_no like concat('%', #{returnNo}, '%')
            </if>
            <if test="deliveryNo != null and deliveryNo != ''">
                AND delivery_no like concat('%', #{deliveryNo}, '%')
            </if>
            <if test="contractNo != null and contractNo != ''">
                AND contract_no like concat('%', #{contractNo}, '%')
            </if>
            <if test="customerName != null and customerName != ''">
                AND customer_name like concat('%', #{customerName}, '%')
            </if>
            <if test="params.beginReturnDate != null and params.beginReturnDate != ''">
                AND return_date &gt;= #{params.beginReturnDate}
            </if>
            <if test="params.endReturnDate != null and params.endReturnDate != ''">
                AND return_date &lt;= #{params.endReturnDate}
            </if>
            <if test="inboundStatus != null and inboundStatus != ''">
                AND inbound_status = #{inboundStatus}
            </if>
        </where>
        order by return_id desc
    </select>

    <insert id="insertSalesReturn" parameterType="com.ruoyi.scm.domain.SalesReturn" useGeneratedKeys="true" keyProperty="returnId">
        insert into scm_sales_return (
            <if test="returnNo != null and returnNo != ''">return_no,</if>
            <if test="deliveryNo != null and deliveryNo != ''">delivery_no,</if>
            <if test="contractNo != null and contractNo != ''">contract_no,</if>
            <if test="customerName != null and customerName != ''">customer_name,</if>
            <if test="returnDate != null">return_date,</if>
            <if test="refundAmount != null">refund_amount,</if>
            <if test="inboundStatus != null and inboundStatus != ''">inbound_status,</if>
            <if test="returnReason != null and returnReason != ''">return_reason,</if>
            <if test="deliveryMethod != null and deliveryMethod != ''">delivery_method,</if>
            <if test="deliveryDate != null">delivery_date,</if>
            <if test="deliveryAddress != null and deliveryAddress != ''">delivery_address,</if>
            <if test="contactPerson != null and contactPerson != ''">contact_person,</if>
            <if test="contactPhone != null and contactPhone != ''">contact_phone,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="returnNo != null and returnNo != ''">#{returnNo},</if>
            <if test="deliveryNo != null and deliveryNo != ''">#{deliveryNo},</if>
            <if test="contractNo != null and contractNo != ''">#{contractNo},</if>
            <if test="customerName != null and customerName != ''">#{customerName},</if>
            <if test="returnDate != null">#{returnDate},</if>
            <if test="refundAmount != null">#{refundAmount},</if>
            <if test="inboundStatus != null and inboundStatus != ''">#{inboundStatus},</if>
            <if test="returnReason != null and returnReason != ''">#{returnReason},</if>
            <if test="deliveryMethod != null and deliveryMethod != ''">#{deliveryMethod},</if>
            <if test="deliveryDate != null">#{deliveryDate},</if>
            <if test="deliveryAddress != null and deliveryAddress != ''">#{deliveryAddress},</if>
            <if test="contactPerson != null and contactPerson != ''">#{contactPerson},</if>
            <if test="contactPhone != null and contactPhone != ''">#{contactPhone},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateSalesReturn" parameterType="com.ruoyi.scm.domain.SalesReturn">
        update scm_sales_return
        <set>
            <if test="returnNo != null and returnNo != ''">return_no = #{returnNo},</if>
            <if test="deliveryNo != null">delivery_no = #{deliveryNo},</if>
            <if test="contractNo != null">contract_no = #{contractNo},</if>
            <if test="customerName != null">customer_name = #{customerName},</if>
            <if test="returnDate != null">return_date = #{returnDate},</if>
            <if test="refundAmount != null">refund_amount = #{refundAmount},</if>
            <if test="inboundStatus != null and inboundStatus != ''">inbound_status = #{inboundStatus},</if>
            <if test="returnReason != null">return_reason = #{returnReason},</if>
            <if test="deliveryMethod != null">delivery_method = #{deliveryMethod},</if>
            <if test="deliveryDate != null">delivery_date = #{deliveryDate},</if>
            <if test="deliveryAddress != null">delivery_address = #{deliveryAddress},</if>
            <if test="contactPerson != null">contact_person = #{contactPerson},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where return_id = #{returnId}
    </update>

    <delete id="deleteSalesReturnById" parameterType="Long">
        delete from scm_sales_return where return_id = #{returnId}
    </delete>

    <delete id="deleteSalesReturnByIds" parameterType="Long">
        delete from scm_sales_return where return_id in
        <foreach item="returnId" collection="array" open="(" separator="," close=")">
            #{returnId}
        </foreach>
    </delete>

    <delete id="deleteDetailByReturnId" parameterType="Long">
        delete from scm_sales_return_detail where return_id = #{returnId}
    </delete>

    <insert id="batchInsertDetail" parameterType="java.util.List">
        insert into scm_sales_return_detail (return_id, seq_no, material_name, product_model, product_spec, unit, price, order_quantity, delivery_quantity, return_quantity, remark)
        values
        <foreach item="item" collection="list" separator=",">
            (#{item.returnId}, #{item.seqNo}, #{item.materialName}, #{item.productModel}, #{item.productSpec}, #{item.unit}, #{item.price}, #{item.orderQuantity}, #{item.deliveryQuantity}, #{item.returnQuantity}, #{item.remark})
        </foreach>
    </insert>

</mapper>
