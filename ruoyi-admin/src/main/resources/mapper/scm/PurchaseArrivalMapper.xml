<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.scm.mapper.PurchaseArrivalMapper">

    <resultMap type="com.ruoyi.scm.domain.PurchaseArrival" id="PurchaseArrivalResult">
        <result property="arrivalId"     column="arrival_id"      />
        <result property="arrivalNo"     column="arrival_no"      />
        <result property="contractNo"    column="contract_no"     />
        <result property="supplierName"  column="supplier_name"   />
        <result property="contactPerson" column="contact_person"  />
        <result property="contactPhone"  column="contact_phone"   />
        <result property="arrivalDate"   column="arrival_date"    />
        <result property="status"        column="status"          />
        <result property="createBy"      column="create_by"       />
        <result property="createTime"    column="create_time"     />
        <result property="updateBy"      column="update_by"       />
        <result property="updateTime"    column="update_time"     />
        <result property="remark"        column="remark"          />
    </resultMap>

    <resultMap type="com.ruoyi.scm.domain.PurchaseArrival" id="PurchaseArrivalDetailResult" extends="PurchaseArrivalResult">
        <collection property="detailList" ofType="com.ruoyi.scm.domain.PurchaseArrivalDetail">
            <result property="detailId"         column="detail_id"          />
            <result property="arrivalId"        column="d_arrival_id"       />
            <result property="seqNo"            column="seq_no"             />
            <result property="materialName"     column="material_name"      />
            <result property="productModel"     column="d_product_model"    />
            <result property="productSpec"      column="d_product_spec"     />
            <result property="unit"             column="d_unit"             />
            <result property="orderQuantity"    column="order_quantity"     />
            <result property="arrivalQuantity"  column="arrival_quantity"   />
            <result property="batchNo"          column="batch_no"           />
            <result property="remark"           column="d_remark"           />
        </collection>
    </resultMap>

    <sql id="selectPurchaseArrivalVo">
        select arrival_id, arrival_no, contract_no, supplier_name, contact_person, contact_phone,
               arrival_date, status, create_by, create_time, update_by, update_time, remark
        from scm_purchase_arrival
    </sql>

    <select id="selectPurchaseArrivalById" parameterType="Long" resultMap="PurchaseArrivalDetailResult">
        select a.arrival_id, a.arrival_no, a.contract_no, a.supplier_name, a.contact_person, a.contact_phone,
               a.arrival_date, a.status, a.create_by, a.create_time, a.update_by, a.update_time, a.remark,
               d.detail_id, d.arrival_id as d_arrival_id, d.seq_no,
               d.material_name, d.product_model as d_product_model,
               d.product_spec as d_product_spec, d.unit as d_unit,
               d.order_quantity, d.arrival_quantity, d.batch_no, d.remark as d_remark
        from scm_purchase_arrival a
        left join scm_purchase_arrival_detail d on a.arrival_id = d.arrival_id
        where a.arrival_id = #{arrivalId}
        order by d.seq_no
    </select>

    <select id="selectPurchaseArrivalList" parameterType="com.ruoyi.scm.domain.PurchaseArrival" resultMap="PurchaseArrivalResult">
        <include refid="selectPurchaseArrivalVo"/>
        <where>
            <if test="arrivalNo != null and arrivalNo != ''">
                AND arrival_no like concat('%', #{arrivalNo}, '%')
            </if>
            <if test="contractNo != null and contractNo != ''">
                AND contract_no like concat('%', #{contractNo}, '%')
            </if>
            <if test="supplierName != null and supplierName != ''">
                AND supplier_name = #{supplierName}
            </if>
            <if test="params.beginArrivalDate != null and params.beginArrivalDate != ''">
                AND arrival_date &gt;= #{params.beginArrivalDate}
            </if>
            <if test="params.endArrivalDate != null and params.endArrivalDate != ''">
                AND arrival_date &lt;= #{params.endArrivalDate}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by arrival_id desc
    </select>

    <insert id="insertPurchaseArrival" parameterType="com.ruoyi.scm.domain.PurchaseArrival" useGeneratedKeys="true" keyProperty="arrivalId">
        insert into scm_purchase_arrival (
            <if test="arrivalNo != null and arrivalNo != ''">arrival_no,</if>
            <if test="contractNo != null and contractNo != ''">contract_no,</if>
            <if test="supplierName != null and supplierName != ''">supplier_name,</if>
            <if test="contactPerson != null and contactPerson != ''">contact_person,</if>
            <if test="contactPhone != null and contactPhone != ''">contact_phone,</if>
            <if test="arrivalDate != null">arrival_date,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="arrivalNo != null and arrivalNo != ''">#{arrivalNo},</if>
            <if test="contractNo != null and contractNo != ''">#{contractNo},</if>
            <if test="supplierName != null and supplierName != ''">#{supplierName},</if>
            <if test="contactPerson != null and contactPerson != ''">#{contactPerson},</if>
            <if test="contactPhone != null and contactPhone != ''">#{contactPhone},</if>
            <if test="arrivalDate != null">#{arrivalDate},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updatePurchaseArrival" parameterType="com.ruoyi.scm.domain.PurchaseArrival">
        update scm_purchase_arrival
        <set>
            <if test="arrivalNo != null and arrivalNo != ''">arrival_no = #{arrivalNo},</if>
            <if test="contractNo != null and contractNo != ''">contract_no = #{contractNo},</if>
            <if test="supplierName != null">supplier_name = #{supplierName},</if>
            <if test="contactPerson != null">contact_person = #{contactPerson},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="arrivalDate != null">arrival_date = #{arrivalDate},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where arrival_id = #{arrivalId}
    </update>

    <delete id="deletePurchaseArrivalById" parameterType="Long">
        delete from scm_purchase_arrival where arrival_id = #{arrivalId}
    </delete>

    <delete id="deletePurchaseArrivalByIds" parameterType="Long">
        delete from scm_purchase_arrival where arrival_id in
        <foreach item="arrivalId" collection="array" open="(" separator="," close=")">
            #{arrivalId}
        </foreach>
    </delete>

    <delete id="deleteDetailByArrivalId" parameterType="Long">
        delete from scm_purchase_arrival_detail where arrival_id = #{arrivalId}
    </delete>

    <insert id="batchInsertDetail" parameterType="java.util.List">
        insert into scm_purchase_arrival_detail (arrival_id, seq_no, material_name, product_model, product_spec, unit, order_quantity, arrival_quantity, batch_no, remark)
        values
        <foreach item="item" collection="list" separator=",">
            (#{item.arrivalId}, #{item.seqNo}, #{item.materialName}, #{item.productModel}, #{item.productSpec}, #{item.unit}, #{item.orderQuantity}, #{item.arrivalQuantity}, #{item.batchNo}, #{item.remark})
        </foreach>
    </insert>

</mapper>
