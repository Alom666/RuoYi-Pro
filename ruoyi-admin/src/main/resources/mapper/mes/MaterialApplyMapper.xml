<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.mapper.MaterialApplyMapper">

    <resultMap type="MaterialApply" id="MaterialApplyResult">
        <result property="applyId"             column="apply_id"              />
        <result property="applyNo"             column="apply_no"              />
        <result property="productionPlanCode"  column="production_plan_code"  />
        <result property="schedulingCode"      column="scheduling_code"       />
        <result property="productName"         column="product_name"          />
        <result property="productModel"        column="product_model"         />
        <result property="productSpec"         column="product_spec"          />
        <result property="productUnit"         column="product_unit"          />
        <result property="pendingQuantity"     column="pending_quantity"      />
        <result property="productionDate"      column="production_date"       />
        <result property="receiveDate"         column="receive_date"          />
        <result property="applicant"           column="applicant"             />
        <result property="applyDate"           column="apply_date"            />
        <result property="applyStatus"         column="apply_status"          />
        <result property="auditor"             column="auditor"               />
        <result property="auditDate"           column="audit_date"            />
        <result property="auditStatus"         column="audit_status"          />
        <result property="auditOpinion"        column="audit_opinion"         />
        <result property="createBy"            column="create_by"             />
        <result property="createTime"          column="create_time"           />
        <result property="updateBy"            column="update_by"             />
        <result property="updateTime"          column="update_time"           />
        <result property="remark"              column="remark"                />
    </resultMap>

    <resultMap type="MaterialApply" id="MaterialApplyDetailResult" extends="MaterialApplyResult">
        <collection property="detailList" ofType="MaterialApplyDetail">
            <result property="detailId"          column="detail_id"           />
            <result property="applyId"           column="apply_id"            />
            <result property="materialName"      column="material_name"       />
            <result property="productModel"      column="d_product_model"     />
            <result property="productSpec"       column="d_product_spec"      />
            <result property="unit"              column="d_unit"              />
            <result property="requiredQuantity"  column="required_quantity"   />
            <result property="receivedQuantity"  column="received_quantity"   />
            <result property="remark"            column="d_remark"            />
        </collection>
    </resultMap>

    <sql id="selectMaterialApplyVo">
        select apply_id, apply_no, production_plan_code, scheduling_code, product_name, product_model,
               product_spec, product_unit, pending_quantity, production_date, receive_date,
               applicant, apply_date, apply_status, auditor, audit_date, audit_status, audit_opinion,
               create_by, create_time, update_by, update_time, remark
        from mes_material_apply
    </sql>

    <select id="selectMaterialApplyById" parameterType="Long" resultMap="MaterialApplyDetailResult">
        select a.apply_id, a.apply_no, a.production_plan_code, a.scheduling_code, a.product_name, a.product_model,
               a.product_spec, a.product_unit, a.pending_quantity, a.production_date, a.receive_date,
               a.applicant, a.apply_date, a.apply_status, a.auditor, a.audit_date, a.audit_status, a.audit_opinion,
               a.create_by, a.create_time, a.update_by, a.update_time, a.remark,
               d.detail_id, d.apply_id, d.material_name, d.product_model as d_product_model,
               d.product_spec as d_product_spec, d.unit as d_unit,
               d.required_quantity, d.received_quantity, d.remark as d_remark
        from mes_material_apply a
        left join mes_material_apply_detail d on a.apply_id = d.apply_id
        where a.apply_id = #{applyId}
        order by d.detail_id
    </select>

    <select id="selectMaterialApplyList" parameterType="MaterialApply" resultMap="MaterialApplyResult">
        select a.apply_id, a.apply_no, a.production_plan_code, a.scheduling_code, a.product_name, a.product_model,
               a.product_spec, a.product_unit, a.pending_quantity, a.production_date, a.receive_date,
               a.applicant, a.apply_date, a.apply_status, a.auditor, a.audit_date, a.audit_status, a.audit_opinion,
               a.create_by, a.create_time, a.update_by, a.update_time, a.remark
        from mes_material_apply a
        <where>
            <if test="applyNo != null and applyNo != ''">
                AND a.apply_no like concat('%', #{applyNo}, '%')
            </if>
            <if test="productionPlanCode != null and productionPlanCode != ''">
                AND a.production_plan_code like concat('%', #{productionPlanCode}, '%')
            </if>
            <if test="schedulingCode != null and schedulingCode != ''">
                AND a.scheduling_code like concat('%', #{schedulingCode}, '%')
            </if>
            <if test="productName != null and productName != ''">
                AND a.product_name like concat('%', #{productName}, '%')
            </if>
            <if test="applicant != null and applicant != ''">
                AND a.applicant like concat('%', #{applicant}, '%')
            </if>
            <if test="applyStatus != null and applyStatus != ''">
                AND a.apply_status = #{applyStatus}
            </if>
            <if test="auditStatus != null and auditStatus != ''">
                AND a.audit_status = #{auditStatus}
            </if>
            <if test="params.beginReceiveDate != null and params.beginReceiveDate != ''">
                AND a.receive_date &gt;= #{params.beginReceiveDate}
            </if>
            <if test="params.endReceiveDate != null and params.endReceiveDate != ''">
                AND a.receive_date &lt;= #{params.endReceiveDate}
            </if>
        </where>
        order by a.apply_id desc
    </select>

    <insert id="insertMaterialApply" parameterType="MaterialApply" useGeneratedKeys="true" keyProperty="applyId">
        insert into mes_material_apply (
            <if test="applyNo != null and applyNo != ''">apply_no,</if>
            <if test="productionPlanCode != null and productionPlanCode != ''">production_plan_code,</if>
            <if test="schedulingCode != null and schedulingCode != ''">scheduling_code,</if>
            <if test="productName != null and productName != ''">product_name,</if>
            <if test="productModel != null and productModel != ''">product_model,</if>
            <if test="productSpec != null and productSpec != ''">product_spec,</if>
            <if test="productUnit != null and productUnit != ''">product_unit,</if>
            <if test="pendingQuantity != null">pending_quantity,</if>
            <if test="productionDate != null">production_date,</if>
            <if test="receiveDate != null">receive_date,</if>
            <if test="applicant != null and applicant != ''">applicant,</if>
            <if test="applyDate != null">apply_date,</if>
            <if test="applyStatus != null and applyStatus != ''">apply_status,</if>
            <if test="auditor != null and auditor != ''">auditor,</if>
            <if test="auditDate != null">audit_date,</if>
            <if test="auditStatus != null and auditStatus != ''">audit_status,</if>
            <if test="auditOpinion != null and auditOpinion != ''">audit_opinion,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="applyNo != null and applyNo != ''">#{applyNo},</if>
            <if test="productionPlanCode != null and productionPlanCode != ''">#{productionPlanCode},</if>
            <if test="schedulingCode != null and schedulingCode != ''">#{schedulingCode},</if>
            <if test="productName != null and productName != ''">#{productName},</if>
            <if test="productModel != null and productModel != ''">#{productModel},</if>
            <if test="productSpec != null and productSpec != ''">#{productSpec},</if>
            <if test="productUnit != null and productUnit != ''">#{productUnit},</if>
            <if test="pendingQuantity != null">#{pendingQuantity},</if>
            <if test="productionDate != null">#{productionDate},</if>
            <if test="receiveDate != null">#{receiveDate},</if>
            <if test="applicant != null and applicant != ''">#{applicant},</if>
            <if test="applyDate != null">#{applyDate},</if>
            <if test="applyStatus != null and applyStatus != ''">#{applyStatus},</if>
            <if test="auditor != null and auditor != ''">#{auditor},</if>
            <if test="auditDate != null">#{auditDate},</if>
            <if test="auditStatus != null and auditStatus != ''">#{auditStatus},</if>
            <if test="auditOpinion != null and auditOpinion != ''">#{auditOpinion},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateMaterialApply" parameterType="MaterialApply">
        update mes_material_apply
        <set>
            <if test="applyNo != null and applyNo != ''">apply_no = #{applyNo},</if>
            <if test="productionPlanCode != null">production_plan_code = #{productionPlanCode},</if>
            <if test="schedulingCode != null">scheduling_code = #{schedulingCode},</if>
            <if test="productName != null">product_name = #{productName},</if>
            <if test="productModel != null">product_model = #{productModel},</if>
            <if test="productSpec != null">product_spec = #{productSpec},</if>
            <if test="productUnit != null">product_unit = #{productUnit},</if>
            <if test="pendingQuantity != null">pending_quantity = #{pendingQuantity},</if>
            <if test="productionDate != null">production_date = #{productionDate},</if>
            <if test="receiveDate != null">receive_date = #{receiveDate},</if>
            <if test="applicant != null">applicant = #{applicant},</if>
            <if test="applyDate != null">apply_date = #{applyDate},</if>
            <if test="applyStatus != null and applyStatus != ''">apply_status = #{applyStatus},</if>
            <if test="auditor != null">auditor = #{auditor},</if>
            <if test="auditDate != null">audit_date = #{auditDate},</if>
            <if test="auditStatus != null and auditStatus != ''">audit_status = #{auditStatus},</if>
            <if test="auditOpinion != null">audit_opinion = #{auditOpinion},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where apply_id = #{applyId}
    </update>

    <delete id="deleteMaterialApplyById" parameterType="Long">
        delete from mes_material_apply where apply_id = #{applyId}
    </delete>

    <delete id="deleteMaterialApplyByIds" parameterType="Long">
        delete from mes_material_apply where apply_id in
        <foreach item="applyId" collection="array" open="(" separator="," close=")">
            #{applyId}
        </foreach>
    </delete>

    <delete id="deleteDetailByApplyId" parameterType="Long">
        delete from mes_material_apply_detail where apply_id = #{applyId}
    </delete>

    <insert id="batchInsertDetail" parameterType="java.util.List">
        insert into mes_material_apply_detail (apply_id, material_name, product_model, product_spec, unit, required_quantity, received_quantity, remark)
        values
        <foreach item="item" collection="list" separator=",">
            (#{item.applyId}, #{item.materialName}, #{item.productModel}, #{item.productSpec}, #{item.unit}, #{item.requiredQuantity}, #{item.receivedQuantity}, #{item.remark})
        </foreach>
    </insert>

</mapper>
